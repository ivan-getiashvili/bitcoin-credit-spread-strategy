# systemd unit for the put spread bot on a Linux server (Ubuntu 24.04 or newer).
# Install: copy to /etc/systemd/system/, then `systemctl enable --now putspread-bot`.
# The code lives in /opt/putspread, owned by the `putspread` user; Deribit keys stay
# in /opt/putspread/.env with mode 600. Both dashboards listen on 127.0.0.1 only and
# reach the internet through Cloudflare Tunnel (deploy/cloudflared.yml).
[Unit]
Description=Put spread bot (Deribit) with live dashboards
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=putspread
WorkingDirectory=/opt/putspread
ExecStart=/usr/bin/node --experimental-strip-types scripts/bot.ts
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/putspread/data

[Install]
WantedBy=multi-user.target
